{
    email {$ADMIN_EMAIL}
    debug
}

# А. Сніппет для заголовків безпеки
(security) {
    header {
        Strict-Transport-Security max-age=31536000;
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer-when-downgrade
    }
}


