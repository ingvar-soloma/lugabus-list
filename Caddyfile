# ==========================================
# 🚀 Нова версія (NeuroProfile V5 - Laravel / Inertia)
# ==========================================
np42.dev, www.np42.dev, np42.ingvarsoloma.dev, www.np42.ingvarsoloma.dev, cognitiveprofile.ingvarsoloma.dev, www.cognitiveprofile.ingvarsoloma.dev {
	# Редірект всього, що не є основним доменом, на головний np42.dev
	@not_main not host np42.dev
	redir @not_main https://np42.dev{uri} permanent

	# Кодування для швидкості
	encode zstd gzip

	# Застосування безпеки
	import security

	# Новий додаток Laravel.test (порт 8001)
	handle {
		reverse_proxy 172.17.0.1:8001
	}
}

# ==========================================
# 💾 Стара версія (Cognitive Profile - API + React)
# ==========================================
old.np42.dev, old.np42.ingvarsoloma.dev {
	# Кодування для швидкості
	encode zstd gzip

	# Застосування безпеки
	import security

	# Старий Backend API (порт 8005)
	handle /api/* {
		reverse_proxy 172.17.0.1:8005 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Старий Frontend (порт 3005)
	handle {
		reverse_proxy 172.17.0.1:3005 {
			@404 status 404
			handle_response @404 {
				rewrite * /
				reverse_proxy 172.17.0.1:3005
			}
		}
	}
}

# Основний домен — поки що тільки редірект
ingvarsoloma.dev {
	root * /opt/professional-blog
	file_server
	encode gzip zstd

	import security

	try_files {path} /index.html
}

# Ваш поточний сайт на піддомені
cv.ingvarsoloma.dev {
	root * /var/www/cv-portfolio
	file_server
	encode gzip zstd

	import security

	try_files {path} /index.html
}
