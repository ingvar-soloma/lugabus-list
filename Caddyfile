np42.dev, www.np42.dev, cognitiveprofile.ingvarsoloma.dev {
    # Редірект з www на основний домен
    @www host www.np42.dev
    redir @www https://np42.dev{uri} permanent

    # Кодування для швидкості
    encode zstd gzip
    
    # Backend API - handle /api first
    handle /api/* {
        reverse_proxy 172.17.0.1:8005 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Застосування безпеки
    import security

    # Frontend SPA Logic
    handle {
        reverse_proxy 172.17.0.1:3005 {
            # Якщо фронтенд повертає 404 (наприклад, при оновленні сторінки /results)
            # Ми перенаправляємо запит на index, щоб React Router підхопив шлях
            intercept_errors
        }
        
        handle_errors {
            # В. Уникаємо "HTML замість картинок"
            # Робимо fallback на index тільки якщо це НЕ запит до статичного файлу (js, css, png...)
            @spa_fallback {
                expression {err.status_code} == 404
                not path_regexp \.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|json|txt|map)$
            }
            rewrite @spa_fallback /
            reverse_proxy @spa_fallback 172.17.0.1:3005
        }
    }
}


# Основний домен — поки що тільки редірект
ingvarsoloma.dev {
    # 301 редірект на піддомен (тимчасово)
    redir https://cv.ingvarsoloma.dev{uri} permanent
}

# Ваш поточний сайт на піддомені
cv.ingvarsoloma.dev {
    root * /var/www/cv-portfolio
    file_server
    encode gzip zstd
    
    import security


    try_files {path} /index.html
}
